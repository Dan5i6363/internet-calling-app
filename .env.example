# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret for Session & Signaling Authorization
JWT_SECRET=development_super_secret_jwt_key_replace_in_production_min_32_chars

# WebRTC STUN/TURN Configuration (JSON string or comma-separated STUNs)
# Defaults to public STUN servers if empty
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478

# Optional TURN Relay Configuration (RFC 5766)
# Set these if deploying across symmetric NAT / strict mobile carrier firewalls
# TURN_URLS=turn:turn.example.com:3478?transport=udp
# TURN_USERNAME=caller_user
# TURN_CREDENTIAL=caller_pass
